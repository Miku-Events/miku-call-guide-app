{
  "name": "miku-call-guide-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@astryxdesign/cli@0.2.0": true,
    "@astryxdesign/core@0.2.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "workerd@1.20260730.1": true
  },
  "engines": {
    "node": ">=24.18.1 <27",
    "npm": ">=11.17.0 <12"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "miniflare": {
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-built-third-party-licenses.mjs && node scripts/bundle-budget.mjs",
    "check:functions": "wrangler pages functions build functions --outdir node_modules/.tmp/pages-functions-build --compatibility-date 2024-09-23 --compatibility-flags nodejs_compat",
    "contracts:sync": "node scripts/sync-data-contracts.mjs",
    "contracts:check": "node scripts/check-data-contracts.mjs",
    "data:check": "node scripts/check-data-dist.mjs",
    "lint": "eslint .",
    "notices:check": "node scripts/check-third-party-notices.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run contracts:check && npm run notices:check && npm run test:e2e:guard && npm run lint && npm test && npm run build && npm run bundle:check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config=playwright.ci.config.ts",
    "test:e2e:guard": "node scripts/check-e2e-source.mjs",
    "smoke:browser": "node scripts/preview-browser-smoke.mjs",
    "smoke:deploy": "node scripts/post-deploy-smoke.mjs",
    "smoke:preview": "node scripts/preview-browser-smoke.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.2.0",
    "@astryxdesign/theme-neutral": "^0.2.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.2.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  }
}
