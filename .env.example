VITE_DATA_MANIFEST_URL=https://cdn.jsdelivr.net/gh/YOUR_ORG/miku-call-guide-data@release/manifest.json
VITE_SUBMISSION_API_URL=https://YOUR_SUBMISSION_API.example.com
# Production must use the exact URL.origin form: lowercase host, no trailing slash,
# no explicit default :443 port, path, query, fragment, credentials, or outer whitespace.
VITE_APP_ORIGIN=http://localhost:5173
# CI sets this to GITHUB_SHA and emits it as dist/release.json.
VITE_RELEASE_ID=local-development
# Official success test site key. Use only for local development and automated tests.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Serverless API only. Never prefix these with VITE_.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
TURNSTILE_EXPECTED_HOSTNAME=
# Generate a unique value with at least 32 UTF-8 bytes; never commit the value.
SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-github-app-private-key-escaped-newlines
GITHUB_APP_INSTALLATION_ID=replace-with-installation-id
GITHUB_DATA_OWNER=YOUR_ORG
GITHUB_DATA_REPO=miku-call-guide-data
GITHUB_DATA_BASE_BRANCH=main
# Official success test secret. local/test may use it; preview/production reject it.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Pages Functions cannot inspect the account-level WAF rule. Set true in
# production only after the shared write-API rate-limit rule is verified.
CLOUDFLARE_WRITE_RATE_LIMIT_CONFIGURED=false
