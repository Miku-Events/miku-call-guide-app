{
  "action": "block",
  "action_parameters": {
    "response": {
      "content": "{\"error\":\"rate_limited\"}",
      "content_type": "application/json",
      "status_code": 429
    }
  },
  "description": "Miku Call Guide auth, submission, and readiness burst guard",
  "enabled": true,
  "expression": "(starts_with(http.request.uri.path, \"/api/auth/\") or starts_with(http.request.uri.path, \"/api/events/\") or http.request.uri.path eq \"/api/ready\")",
  "ratelimit": {
    "characteristics": [
      "cf.colo.id",
      "ip.src"
    ],
    "mitigation_timeout": 10,
    "period": 10,
    "requests_per_period": 10
  },
  "ref": "miku-call-guide-api-burst-v1"
}
